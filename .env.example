# Copy to .env in the repo root (git-ignored); apps/web/next.config.ts loads it. In production, set these in the host's
# environment variables, not in a file. Don't put keys in code: https://docs.stripe.com/keys-best-practices
#
# Server-only. Test key from https://dashboard.stripe.com/test/apikeys; a restricted key with write access to
# Checkout Sessions is enough.
# Keep false until the app can activate issued licences and the end-to-end purchase has been tested.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Ed25519 private key, PKCS#8 DER encoded as base64. Never commit one. For development run `bun run licence:dev-key`
# in apps/web, which writes it here. Keep the production key backed up in a password manager.
LICENCE_SIGNING_KEY=...
# Shipmail API keys (https://shipmail.to/developer/api-keys), each with only the messages:send scope, limited to the
# sending mailbox. `next dev` and tests use SHIPMAIL_API_KEY_TEST (sm_test_), which simulates sends and delivers nothing.
# NODE_ENV=production (`next build` and `next start`, even locally) selects SHIPMAIL_API_KEY; there is no fallback.
# For previews or local production runs that should simulate sends, set SHIPMAIL_API_KEY to an sm_test_ key.
SHIPMAIL_API_KEY_TEST=sm_test_...
SHIPMAIL_API_KEY=sm_live_...
# The Shipmail mailbox licence emails are sent from: an address, or "Name <address>". Replies go to this mailbox.
LICENCE_EMAIL_FROM="My Screen Cam <info@myscreen.cam>"
