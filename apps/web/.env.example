# Copy to .env.local (git-ignored) for local development. In production, set these in the host's environment
# variables, not in a file. Don't put keys in code: https://docs.stripe.com/keys-best-practices
#
# Server-only. Test key from https://dashboard.stripe.com/test/apikeys; a restricted key with write access to
# Checkout Sessions is enough.
# Keep false until the app can activate issued licences and the end-to-end purchase has been tested.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Ed25519 private key, PKCS#8 DER encoded as base64. Keep the production key backed up.
LICENCE_SIGNING_KEY=...
RESEND_API_KEY=re_...
LICENCE_EMAIL_FROM=My Screen Cam <licences@myscreen.cam>
